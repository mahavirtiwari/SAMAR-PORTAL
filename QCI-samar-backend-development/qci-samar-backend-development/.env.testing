APP_NAME="QCI SAMAR"
APP_ENV=testing
APP_KEY=base64:Xv9dmFUKacoDmoi9OyX1FAK/25z6lYWg8M+jDTB4hxI=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost

# Tests run against MySQL (same engine as dev/staging/prod) on a dedicated
# qci_samar_test database that RefreshDatabase rebuilds each run. Requires a
# local MySQL with that database created. Loaded because APP_ENV=testing.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qci_samar_test
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

BCRYPT_ROUNDS=4

JWT_SECRET=test-jwt-secret-key-for-testing-purposes-only

L5_SWAGGER_ENABLED=false
LOG_CHANNEL=null
