#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Branch synchronization logic (from .githooks) - strict blocking
branch=$(git rev-parse --abbrev-ref HEAD)
git fetch origin $branch
LOCAL=$(git rev-parse @)
REMOTE=$(git rev-parse @{u})
BASE=$(git merge-base @ @{u})

if [ $LOCAL = $REMOTE ]; then
    echo "Your branch is up-to-date with the remote branch."
elif [ $LOCAL = $BASE ]; then
    echo "Your branch is behind the remote branch. Attempting to rebase..."
    git pull --rebase origin $branch
    if [ $? -ne 0 ]; then
        echo "Rebase failed. Please resolve conflicts manually."
        exit 1
    else
        echo "Rebase successful."
    fi
elif [ $REMOTE = $BASE ]; then
    echo "Your branch is ahead of the remote branch. You can push your changes."
else
    echo "Your branch has diverged from the remote branch. Attempting to rebase..."
    git pull --rebase origin $branch
    if [ $? -ne 0 ]; then
        echo "Rebase failed. Please resolve conflicts manually."
        exit 1
    else
        echo "Rebase successful."
    fi
fi

echo "🔍 Running lint-staged to check code quality..."
npx lint-staged
if [ $? -ne 0 ]; then
    echo "⚠️ WARNING: There are code quality issues that should be fixed."
    echo "Allowing commit to proceed anyway. Please fix these issues when possible."
fi
