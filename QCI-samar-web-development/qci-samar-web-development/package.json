{
  "name": "qci-samar-web",
  "version": "0.20.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/prebuild.js",
    "dev": "npm run prebuild -- Local && vite",
    "dev:development": "npm run prebuild -- Development && vite",
    "dev:staging": "npm run prebuild -- Staging && vite",
    "dev:production": "npm run prebuild -- Production && vite",
    "start": "npm run dev",
    "start:development": "npm run dev:development",
    "start:production": "npm run dev:production",
    "start:staging": "npm run dev:staging",
    "build": "vite build",
    "build:development": "npm run prebuild -- Development && vite build && node scripts/verify-build.js",
    "build:local": "npm run prebuild -- Local && vite build && node scripts/verify-build.js",
    "build:production": "npm run prebuild -- Production && vite build && node scripts/verify-build.js",
    "build:staging": "npm run prebuild -- Staging && vite build && node scripts/verify-build.js",
    "staging": "npm run build:staging",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-charts": "^9.15.0",
    "@mui/x-data-grid": "^9.15.0",
    "@mui/x-date-pickers": "^9.15.0",
    "@reduxjs/toolkit": "^2.13.0",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "bootstrap": "^5.3.8",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "formik": "^2.4.9",
    "input-otp": "^1.5.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "redux": "^5.0.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sass": "^1.105.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
