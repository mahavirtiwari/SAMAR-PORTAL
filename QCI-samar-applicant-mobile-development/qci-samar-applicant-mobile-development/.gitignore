# Generated by prebuild.js — never commit
appsettings.Compiled.json

# CocoaPods lockfile is tracked on purpose. The blanket *.lock rules above would
# otherwise swallow it, leaving every machine to resolve its own pod versions.
# Without it an RN version bump leaves the native tree stale while `pod install`
# still reports success, and the app dies at launch on a dyld symbol mismatch.
!ios/Podfile.lock

# Xcode device build output
ios/build-device/
