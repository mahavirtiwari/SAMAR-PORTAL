+  // Remaps a "video/dolby-vision" input to its decodable HEVC base layer in
+  // place, so MediaCodec can select a standard decoder. Profile 5 (no base
+  // layer) is already rejected up front in start() via isUnsupportedDolbyVision,
+  // so anything reaching here is a profile 8.x stream that carries an HEVC base
+  // layer and can simply be treated as HEVC (#398).
+    private fun ensureDecodableVideoFormat(inputFormat: MediaFormat) {
+        val mime = inputFormat.getString(MediaFormat.KEY_MIME) ?: return
+        if (mime.equals("video/dolby-vision", ignoreCase = true)) {
+            inputFormat.setString(MediaFormat.KEY_MIME, "video/hevc")
+        }
+    }
